# Blizzard API
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# AI provider:
# ollama | gemini | custom
# Default is ollama (local). Only the selected provider's extra keys are required.
LLM_PROVIDER=ollama

# Model used by the selected provider
# Ollama default: llama3.1:8b
# Gemini / custom: set this to the model that provider expects
LLM_MODEL=llama3.1:8b

# Ollama / custom OpenAI-compatible URL
# Used by ollama (default below) and by custom. Ignored by gemini.
LLM_BASE_URL=http://localhost:11434/v1

# Used only for custom OpenAI-compatible APIs
LLM_API_KEY=

# Used only when LLM_PROVIDER=gemini
GEMINI_API_KEY=
